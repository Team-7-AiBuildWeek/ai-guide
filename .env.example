# Copy to .env. With the fakes below the whole stack runs offline at $0.
# Providers: gemini | fake, chirp | fake, ors | fake
LLM_PROVIDER=fake
TTS_PROVIDER=fake
ROUTING_PROVIDER=fake

# Real providers. Cloud TTS authenticates with Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON).
GEMINI_API_KEY=
ORS_API_KEY=
# Wikimedia asks for a contact address in the User-Agent (walk seed-city).
WIKIMEDIA_CONTACT=
GOOGLE_APPLICATION_CREDENTIALS=

SCRIPT_MODEL=gemini-3.8-flash
MECHANICAL_MODEL=gemini-3.5-flash-lite
SCRIPT_VERSION=1
TTS_MODEL=chirp3-hd
VOICE_NAME=Charon

# Hard caps for on-demand generation. Prewarm takes its own cap on the command line.
REQUEST_BUDGET_USD=3.00
DAILY_BUDGET_USD=20.00

# /admin/* requires this in the X-Admin-Token header.
ADMIN_TOKEN=change-me

# Production storage (Cloudflare R2):
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=walk-audio
# S3_REGION=auto
