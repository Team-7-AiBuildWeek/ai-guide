# Copy to .env.local and fill in only what you need.
# Every provider defaults to "mock". With no file at all, the whole app works
# offline with no keys and no spend. That is intentional — build and click
# through the entire flow before paying for anything.

# ---------------------------------------------------------------- selection

# mock | anthropic | openai | google
LLM_PROVIDER=mock

# mock | elevenlabs | openai | google
TTS_PROVIDER=mock

# mock | stadia | maptiler | mapbox | osm
#   stadia = tiles + geocoding + walking routes, all from one key
#   osm    = OpenRouteService routing + Nominatim geocoding + OpenFreeMap tiles
# Google Maps / Places is deliberately not an option: their terms forbid
# text-to-speech use of their content and forbid generating content from it.
MAP_PROVIDER=mock

# ------------------------------------------------------------------- keys
# Only the selected provider's key is ever read.

# Stadia Maps — covers tiles, geocoding and routing on its own.
STADIA_API_KEY=
# Optional. api-eu.stadiamaps.com is the closer endpoint for a Bratislava app.
STADIA_BASE_URL=https://api.stadiamaps.com
# alidade_smooth | alidade_smooth_dark | outdoors | osm_bright | stamen_toner
STADIA_STYLE=alidade_smooth
# Set true in production. Tiles are then authorised by the browser's Origin
# header and the key is never put in the page. Add the domain under
# Manage Properties -> Authentication Configuration in the Stadia dashboard
# first, or every tile request 401s. Geocoding and routing still use the key,
# server-side, where it stays private.
STADIA_DOMAIN_AUTH=false

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Free tier, needed only for real walking routes. Without it the OSM provider
# still geocodes and still shows tiles; the drawn route is a straight line.
OPENROUTESERVICE_API_KEY=

# ----------------------------------------------------------------- models
# Overridable so a new model release doesn't need a code change.

ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1
GOOGLE_MODEL=gemini-2.0-flash

# eleven_flash_v2_5 answers in about a second, which is what a walker waiting
# on the next piece of narration needs. eleven_multilingual_v2 reads better and
# takes longer — worth it once latency stops being the problem.
ELEVENLABS_MODEL=eleven_flash_v2_5

# sonic-3.5 is the current Cartesia model; sonic-latest follows the newest.
# Cartesia is told the language rather than inferring it, and covers all
# seventeen the app offers.
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# Rachel, unless you audition something better at /dev/tts.
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------ misc
# Nominatim's usage policy requires a real contact address here.
NOMINATIM_USER_AGENT=walk-bratislava-mvp (you@example.com)
